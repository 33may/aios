# Knowledge Graph Configuration
# Copy this file to .env and update values

# Backend selection: memory (default), postgres, or neo4j
KNOWLEDGE_BACKEND=neo4j

# PostgreSQL connection (only needed for postgres backend)
KNOWLEDGE_DB_HOST=192.168.1.100    # Your home server IP
KNOWLEDGE_DB_PORT=5432
KNOWLEDGE_DB_NAME=knowledge_graph
KNOWLEDGE_DB_USER=knowledge
KNOWLEDGE_DB_PASSWORD=your-secure-password-here

# Neo4j connection (only needed for neo4j backend)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword
NEO4J_DATABASE=neo4j

# Embedding settings
KNOWLEDGE_EMBEDDING_DIM=1536       # OpenAI ada-002 dimension

# Client behavior
KNOWLEDGE_TIMEOUT=30
