#!/bin/bash
# Knowledge Graph Boot Script
# Starts Neo4j database and dashboard for the management agent

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Detect container runtime (prefer podman on Linux)
if command -v podman-compose &> /dev/null; then
    COMPOSE="podman-compose"
    CONTAINER_CMD="podman"
elif command -v podman &> /dev/null && podman compose version &> /dev/null 2>&1; then
    COMPOSE="podman compose"
    CONTAINER_CMD="podman"
elif command -v docker &> /dev/null && docker compose version &> /dev/null 2>&1; then
    COMPOSE="docker compose"
    CONTAINER_CMD="docker"
elif command -v docker-compose &> /dev/null; then
    COMPOSE="docker-compose"
    CONTAINER_CMD="docker"
else
    log_error "No container runtime found. Install podman-compose or docker."
    log_info "On Ubuntu/Debian: sudo apt install podman-compose"
    exit 1
fi

log_info "Using: $COMPOSE"

# Parse arguments
DASHBOARD_ONLY=false
DB_ONLY=false
STOP=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --dashboard)
            DASHBOARD_ONLY=true
            shift
            ;;
        --db)
            DB_ONLY=true
            shift
            ;;
        --stop)
            STOP=true
            shift
            ;;
        --help|-h)
            echo "Usage: $0 [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --dashboard  Start dashboard only (no database)"
            echo "  --db         Start database only (no dashboard)"
            echo "  --stop       Stop all services"
            echo "  --help       Show this help"
            echo ""
            echo "Services:"
            echo "  Neo4j:       http://localhost:7474 (browser)"
            echo "               bolt://localhost:7687 (connection)"
            echo "  Dashboard:   http://localhost:8501"
            exit 0
            ;;
        *)
            log_error "Unknown option: $1"
            exit 1
            ;;
    esac
done

cd "$PROJECT_DIR"

# Stop services
if [ "$STOP" = true ]; then
    log_info "Stopping services..."

    # Stop dashboard
    pkill -f "streamlit run apps/dashboard" 2>/dev/null && log_success "Stopped dashboard" || log_warn "Dashboard not running"

    # Stop database
    cd deploy/neo4j
    $COMPOSE down 2>/dev/null && log_success "Stopped Neo4j" || log_warn "Neo4j not running"

    log_success "All services stopped"
    exit 0
fi

# Start database
start_database() {
    log_info "Starting Neo4j database..."
    cd "$PROJECT_DIR/deploy/neo4j"

    $COMPOSE up -d
    log_success "Neo4j starting on http://localhost:7474"
    log_info "  Login: neo4j / devpassword"

    # Wait for database to be ready
    log_info "Waiting for Neo4j to be ready..."
    for i in {1..60}; do
        if $COMPOSE exec -T neo4j cypher-shell -u neo4j -p devpassword "RETURN 1" > /dev/null 2>&1; then
            log_success "Neo4j is ready"
            return 0
        fi
        sleep 2
    done

    log_warn "Neo4j may still be starting... continuing anyway"
    return 0
}

# Start dashboard
start_dashboard() {
    log_info "Starting Streamlit dashboard..."
    cd "$PROJECT_DIR"

    # Check if already running
    if pgrep -f "streamlit run apps/dashboard" > /dev/null; then
        log_warn "Dashboard already running"
        return 0
    fi

    # Load environment variables
    if [ -f "$PROJECT_DIR/.env" ]; then
        set -a
        source "$PROJECT_DIR/.env"
        set +a
    fi

    # Activate conda environment and start in background
    source /home/may/miniconda3/etc/profile.d/conda.sh
    conda activate management_agent
    nohup streamlit run apps/dashboard/app.py --server.headless true > logs/dashboard.log 2>&1 &

    # Wait for it to start
    sleep 3

    if pgrep -f "streamlit run apps/dashboard" > /dev/null; then
        log_success "Dashboard started on http://localhost:8501"
    else
        log_error "Dashboard failed to start. Check logs/dashboard.log"
        return 1
    fi
}

# Create logs directory
mkdir -p "$PROJECT_DIR/logs"

# Main execution
echo ""
echo "========================================"
echo "   Knowledge Graph Boot Script"
echo "========================================"
echo ""

if [ "$DASHBOARD_ONLY" = true ]; then
    start_dashboard
elif [ "$DB_ONLY" = true ]; then
    start_database
else
    start_database
    start_dashboard
fi

echo ""
echo "========================================"
log_success "Boot complete!"
echo ""
echo "Services:"
if [ "$DASHBOARD_ONLY" != true ]; then
    echo "  Neo4j:      http://localhost:7474"
    echo "              bolt://localhost:7687"
fi
if [ "$DB_ONLY" != true ]; then
    echo "  Dashboard:  http://localhost:8501"
fi
echo ""
echo "To stop: $0 --stop"
echo "========================================"
