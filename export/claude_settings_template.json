{
  "permissions": {
    "allow": [
      "Bash(git clone:*)",
      "Bash(python3:*)",
      "mcp__knowledge__initialize_session",
      "mcp__knowledge__list_projects",
      "mcp__knowledge__add_thought",
      "mcp__knowledge__get_project_context",
      "mcp__knowledge__get_recent_activity",
      "Bash(git add:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${PROJECT_ROOT}/apps/mcp/hooks/knowledge_reminder.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${PROJECT_ROOT}/apps/mcp/hooks/knowledge_reminder.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${PROJECT_ROOT}/apps/mcp/hooks/pretool_thought_reminder.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${PROJECT_ROOT}/apps/mcp/hooks/stop_thought_capture.py"
          }
        ]
      }
    ]
  },
  "_note": "Replace ${PROJECT_ROOT} with your actual project path, and use the python from your conda environment"
}
