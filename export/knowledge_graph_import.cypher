CREATE (:Task:`UNIQUE IMPORT LABEL` {content:\"Build Knowledge Graph Explorer GUI - Tauri + React + Cytoscape.js desktop application for visualizing and interacting with the knowledge graph\", created_at:\"2026-01-23T12:52:23.449798\", meta_depth:0, meta_description:\"Desktop application for knowledge graph visualization and management.\n\nFULL PLAN: docs/specs/knowledge-graph-explorer-gui.md\n\nContains:\n- Critical analysis of 10+ GUI options (Streamlit, Dash, PyQt, Dear PyGui, Tauri, etc.)\n- Final recommendation: Tauri + React + Cytoscape.js\n- Architecture diagram\n- Complete file structure (~25 files)\n- 4-phase implementation roadmap\n- Tech stack details\n- Step-by-step implementation plan\n- Verification criteria\n\nTech Stack:\n- Tauri 2.0 (desktop shell, 10MB vs Electron's 200MB)\n- React 18 + TypeScript\n- Cytoscape.js (graph visualization)\n- Tailwind CSS + shadcn/ui\n- Rust + neo4rs (Neo4j driver)\n\nLocation: apps/explorer/\n\nPhases:\n1. Core Graph Explorer - interactive graph, node styling, detail panel\n2. Navigation & Search - sidebar, filters, focus mode\n3. Task Management - status toggle, CRUD, drag-drop\n4. Research Features - sources, timeline, export\", meta_project_id:\"fc816fde-6aae-47fd-97b3-666e66ca09c1\", meta_spec_file:\"docs/specs/knowledge-graph-explorer-gui.md\", meta_status:\"pending\", meta_subject:\"Build Knowledge Graph Explorer GUI\", type:\"task\", updated_at:datetime('2026-01-23T12:54:15.414Z'), uuid:\"108b6c12-febb-4e36-ac66-841f99974ec7\", `UNIQUE IMPORT ID`:20});
CREATE (:Task:`UNIQUE IMPORT LABEL` {content:\"Restructure knowledge system from task-centric to knowledge-centric with Claude Code subagents\", created_at:\"2026-01-23T13:07:45.008526\", meta_depth:0, meta_description:\"Restructure the knowledge graph from task-centric to knowledge-centric.\n\n## Core Changes\n\n1. **Organic Knowledge Structure**\n   - Less rigid hierarchy, more graph-like connections\n   - Capture reasoning chains, not just conclusions\n   - Problems, discussions, trade-offs, constraints all as nodes\n   - Projects as top-level containers with branching structures inside\n\n2. **New Node Types**\n   - thought - reasoning, observations, ideas\n   - constraint - user preferences that shape decisions\n   - problem - something encountered\n   - fix - solution to a problem\n   - resource - files, URLs, specs\n\n3. **Edge Types for Reasoning**\n   - led_to, supports, contradicts, refined_by\n   - constrained_by, spawned, references\n\n4. **Tags for Filtering**\n   - #active, #reasoning, #constraint, #architecture, #debugging\n   - Enable quick filtering like \\"active tasks\\"\n\n## Files to Modify\n- CLAUDE.md - Update instructions for knowledge usage\n- apps/mcp/tools/ - May need new MCP tools for node types\n- apps/backend/integrations/graphiti/models.py - Schema updates\n\n## Branch\nfeature/knowledge-restructure\", meta_project_id:\"fc816fde-6aae-47fd-97b3-666e66ca09c1\", meta_status:\"pending\", meta_subject:\"Knowledge System Restructure\", meta_tags:\"[\\"architecture\\", \\"knowledge-system\\"]\", type:\"task\", updated_at:datetime('2026-01-23T13:08:38.106Z'), uuid:\"f6877b72-b82c-4ce5-9161-76fb2f351324\", `UNIQUE IMPORT ID`:21});
CREATE (:Constraint:`UNIQUE IMPORT LABEL` {content:\"Task structure should be hierarchical with domain areas as top-level tasks, subtasks nested underneath. Example: MCP Knowledge Base → Fix semantic search, Research Agents → Implement orchestrator, etc.\", created_at:\"2026-01-24T13:40:06.515922\", meta_active:true, meta_priority:\"high\", meta_project_id:\"null\", meta_source:\"user\", meta_tags:\"[\\"source:user\\", \\"structure\\", \\"task-organization\\"]\", type:\"constraint\", updated_at:\"2026-01-24T13:40:06.515934\", uuid:\"7fc6212c-4374-41aa-aded-1fe4e713eeb8\", `UNIQUE IMPORT ID`:22});
