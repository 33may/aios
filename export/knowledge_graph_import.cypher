CREATE (:Thought:`UNIQUE IMPORT LABEL` {content:\"Need to fix update_task to remove old contains edges when moving tasks. Currently creates new edge but leaves old one, causing tasks to appear under multiple parents.\", created_at:\"2026-01-24T13:43:46.411557\", meta_context:\"null\", meta_project_id:\"null\", meta_tags:\"[\\"source:agent\\", \\"bug\\", \\"edge-management\\"]\", type:\"thought\", updated_at:\"2026-01-24T13:43:46.411568\", uuid:\"60d7c3d4-4ec8-4875-bc39-e80c81c5faf1\", `UNIQUE IMPORT ID`:176});
